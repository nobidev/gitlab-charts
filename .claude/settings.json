{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/rubocop-staged.sh\"",
            "timeout": 180,
            "statusMessage": "Running RuboCop on staged Ruby files"
          }
        ]
      }
    ]
  }
}
